{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:schema:common:1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "storageRef": {
      "type": "object",
      "required": [
        "scheme",
        "locator"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "integrity": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "urn:noema:schema:common:1#/$defs/storageRef"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "qualityEvidence": {
      "type": "object",
      "required": [
        "claim_id",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "$ref": "urn:noema:schema:common:1#/$defs/identifier"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:noema:schema:common:1#/$defs/storageRef"
          }
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "unassessed"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
