{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:schema:execution-envelope:0",
  "type": "object",
  "required": ["execution_id", "work_order_ref", "work_order_id", "project_id", "profile", "policy_version", "created_at", "baseline_ref", "disposition", "reason_codes", "decision", "context", "runtime_resource_policy", "capability_requirements", "resolver_receipts", "tool_decisions", "executor", "model", "topology", "evaluation_constraints", "recovery", "evidence_refs"],
  "properties": {
    "execution_id": {"type": "string", "pattern": "^exec-[a-z0-9-]+$"}, "work_order_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}, "work_order_id": {"$ref": "urn:noema:schema:common:1#/$defs/identifier"}, "project_id": {"$ref": "urn:noema:schema:common:1#/$defs/identifier"}, "profile": {"type": "string"}, "policy_version": {"type": "string"}, "created_at": {"$ref": "urn:noema:schema:common:1#/$defs/timestamp"}, "baseline_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}, "disposition": {"enum": ["DIRECT_EXECUTION", "ROUTED", "NO_ACTION", "DEFER", "ROUTE_ELSEWHERE", "BLOCKED"]}, "reason_codes": {"type": "array", "items": {"type": "string"}},
    "decision": {"$ref": "#/$defs/decision"}, "context": {"$ref": "#/$defs/context"}, "runtime_resource_policy": {"$ref": "#/$defs/runtimePolicy"}, "capability_requirements": {"type": "array", "items": {"type": "object"}}, "resolver_receipts": {"type": "array", "items": {"$ref": "#/$defs/resolverReceipt"}}, "tool_decisions": {"type": "array", "items": {"$ref": "#/$defs/toolDecision"}}, "executor": {"$ref": "#/$defs/executor"}, "model": {"$ref": "#/$defs/model"}, "topology": {"$ref": "#/$defs/topology"}, "evaluation_constraints": {"$ref": "#/$defs/evaluation"}, "recovery": {"$ref": "#/$defs/recovery"}, "evidence_refs": {"type": "array", "items": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"topology": {"properties": {"mode": {"const": "PARALLEL_ISOLATED"}}, "required": ["mode"]}}}, "then": {"properties": {"topology": {"properties": {"write_scopes": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "role_bindings": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["role_id", "scope"], "properties": {"role_id": {"type": "string"}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": true}}}, "required": ["write_scopes", "role_bindings"]}}}}],
  "$defs": {
    "decision": {"type": "object", "required": ["deliberation", "action_effect", "data_sensitivity", "authority_scope", "control"], "properties": {"deliberation": {"enum": ["MINIMAL", "STANDARD", "DEEP"]}, "action_effect": {"enum": ["REASON", "READ", "WRITE_REVERSIBLE", "WRITE_DESTRUCTIVE", "CANONICAL_MUTATION", "EXTERNAL_COMMITMENT", "PUBLICATION"]}, "data_sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET", "UNKNOWN"]}, "authority_scope": {"enum": ["LOCAL_PROJECT", "DECLARED_RELATION", "FOREIGN", "UNKNOWN"]}, "control": {"enum": ["ALLOW", "ALLOW_SCOPED", "REQUIRE_HUMAN", "DENY", "DEFER", "ROUTE_ELSEWHERE"]}}, "additionalProperties": false},
    "contextRef": {"type": "object", "required": ["ref", "load_tier", "reason_codes"], "properties": {"ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}, "load_tier": {"enum": ["HOT", "WARM", "COLD", "NEVER_PRELOAD"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "context": {"type": "object", "required": ["mode", "refs", "noema_context_units", "tier_transitions", "read_set_policy"], "properties": {"mode": {"enum": ["patch", "build", "audit", "research", "architect", "recover"]}, "refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "noema_context_units": {"type": "integer", "minimum": 0}, "preloaded_noema_context_units": {"type": "integer", "minimum": 0}, "exclusions": {"type": "array", "items": {"type": "string"}}, "tier_transitions": {"type": "array", "items": {"type": "object", "required": ["ref", "from", "to", "reason_code"], "properties": {"ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}, "from": {"enum": ["WARM", "COLD", "NEVER_PRELOAD"]}, "to": {"const": "HOT"}, "reason_code": {"type": "string"}}, "additionalProperties": false}}, "read_set_policy": {"type": "object", "required": ["dedupe_by_ref_and_freshness"], "properties": {"dedupe_by_ref_and_freshness": {"type": "boolean"}}, "additionalProperties": false}}, "additionalProperties": false},
    "runtimePolicy": {"type": "object", "required": ["posture", "parallelism_ceiling", "optional_external_calls", "dedupe_reads", "batch_reads_when_safe", "reason_codes"], "properties": {"posture": {"enum": ["NORMAL", "CONSERVE", "THROTTLED", "BLOCKED", "UNKNOWN"]}, "parallelism_ceiling": {"type": "integer", "minimum": 1}, "optional_external_calls": {"enum": ["NORMAL", "CONSERVE", "DEFER"]}, "dedupe_reads": {"type": "boolean"}, "batch_reads_when_safe": {"type": "boolean"}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "snapshot_ref": {"type": ["object", "null"]}}, "additionalProperties": false},
    "resolverReceipt": {"type": "object", "required": ["resolver", "status", "result_ref", "integrity", "observed_at"], "properties": {"resolver": {"type": "string"}, "status": {"enum": ["RESOLVED", "PARTIAL", "UNRESOLVED", "NOT_REQUIRED", "BLOCKED"]}, "result_ref": {"type": ["object", "null"]}, "integrity": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}}, "additionalProperties": false},
    "toolDecision": {"type": "object", "required": ["candidate", "decision", "reason_codes", "source_relation", "availability", "qualification"], "properties": {"candidate": {"type": "string"}, "decision": {"enum": ["CALL", "SOFT_SUPPRESS", "HARD_DENY", "DEFER"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "source_relation": {"type": "string"}, "availability": {"type": "string"}, "qualification": {"type": "string"}}, "additionalProperties": false},
    "executor": {"type": "object", "required": ["requirements", "selected_executor", "status"], "properties": {"requirements": {"type": "object"}, "selected_executor": {"type": ["string", "null"]}, "status": {"type": "string"}, "eligible": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "model": {"type": "object", "required": ["requirements", "selected_model", "selection"], "properties": {"requirements": {"type": "object"}, "selected_model": {"type": ["string", "null"]}, "selection": {"enum": ["RUNTIME_CANDIDATE", "UNBOUND_HOST_SELECTED"]}}, "additionalProperties": false},
    "topology": {"type": "object", "required": ["mode", "max_parallelism", "role_bindings"], "properties": {"mode": {"enum": ["SINGLE", "AUDITED_SINGLE", "PARALLEL_ISOLATED"]}, "max_parallelism": {"type": "integer", "minimum": 1, "maximum": 2}, "role_bindings": {"type": "array", "items": {"type": "object", "required": ["role_id"], "properties": {"role_id": {"type": "string"}, "authority": {"type": "string"}, "scope": {"type": "array", "items": {"type": "string"}}, "workspace": {"type": ["string", "null"]}, "branch": {"type": ["string", "null"]}, "executor_id": {"type": ["string", "null"]}, "model_id": {"type": ["string", "null"]}, "provenance_refs": {"type": "array", "items": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}}}, "additionalProperties": false}}, "write_scopes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evaluation": {"type": "object", "required": ["quality_claim_ids", "required_grader_classes", "exact_target_required", "independent_review_required", "regression_sensitive"], "properties": {"quality_claim_ids": {"type": "array", "items": {"type": "string"}}, "required_grader_classes": {"type": "array", "items": {"type": "string"}}, "exact_target_required": {"type": "boolean"}, "independent_review_required": {"type": "boolean"}, "regression_sensitive": {"type": "boolean"}}, "additionalProperties": false},
    "recovery": {"type": "object", "required": ["retry_cap", "idempotency_key", "checkpoint_ref", "rollback_ref", "resume_check_required", "expected_sha", "expected_role", "expected_executor", "expected_branch", "expected_workspace", "expected_frontier_ref", "required_closed_claims", "required_human_gates", "prohibited_scope", "allowed_writes"], "properties": {"retry_cap": {"type": "integer", "minimum": 0, "maximum": 10}, "idempotency_key": {"type": ["string", "null"]}, "checkpoint_ref": {"type": ["object", "null"]}, "rollback_ref": {"type": ["object", "null"]}, "resume_check_required": {"type": "boolean"}, "expected_sha": {"type": ["string", "null"]}, "expected_role": {"type": ["string", "null"]}, "expected_executor": {"type": ["string", "null"]}, "expected_branch": {"type": ["string", "null"]}, "expected_workspace": {"type": ["string", "null"]}, "expected_frontier_ref": {"type": ["object", "null"]}, "required_closed_claims": {"type": "array", "items": {"type": "string"}}, "required_human_gates": {"type": "array", "items": {"type": "string"}}, "prohibited_scope": {"type": "array", "items": {"type": "string"}}, "allowed_writes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  }
}
