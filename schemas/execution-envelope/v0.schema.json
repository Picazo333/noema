{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:schema:execution-envelope:0",
  "type": "object",
  "required": ["execution_id", "work_order_ref", "project_id", "profile", "policy_version", "created_at", "baseline_ref", "disposition", "reason_codes", "decision", "context", "capability_requirements", "resolver_receipts", "tool_decisions", "executor", "model", "topology", "evaluation_constraints", "recovery", "evidence_refs"],
  "properties": {
    "execution_id": {"type": "string", "pattern": "^exec-[a-z0-9-]+$"},
    "work_order_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"},
    "project_id": {"$ref": "urn:noema:schema:common:1#/$defs/identifier"},
    "profile": {"type": "string"}, "policy_version": {"type": "string"},
    "created_at": {"$ref": "urn:noema:schema:common:1#/$defs/timestamp"},
    "baseline_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"},
    "disposition": {"enum": ["DIRECT_EXECUTION", "ROUTED", "NO_ACTION", "DEFER", "ROUTE_ELSEWHERE", "BLOCKED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "object", "required": ["deliberation", "action_effect", "data_sensitivity", "authority_scope", "control"], "properties": {"deliberation": {"enum": ["MINIMAL", "STANDARD", "DEEP"]}, "action_effect": {"enum": ["REASON", "READ", "WRITE_REVERSIBLE", "WRITE_DESTRUCTIVE", "CANONICAL_MUTATION", "EXTERNAL_COMMITMENT", "PUBLICATION"]}, "data_sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET", "UNKNOWN"]}, "authority_scope": {"enum": ["LOCAL_PROJECT", "DECLARED_RELATION", "FOREIGN", "UNKNOWN"]}, "control": {"enum": ["ALLOW", "ALLOW_SCOPED", "REQUIRE_HUMAN", "DENY", "DEFER", "ROUTE_ELSEWHERE"]}}, "additionalProperties": false},
    "context": {"type": "object", "required": ["mode", "refs", "noema_context_units"], "properties": {"mode": {"enum": ["patch", "build", "audit", "research", "architect", "recover"]}, "refs": {"type": "array", "items": {"type": "object", "required": ["ref", "load_tier", "reason_codes"], "properties": {"ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}, "load_tier": {"enum": ["HOT", "WARM", "COLD", "NEVER_PRELOAD"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "noema_context_units": {"type": "integer", "minimum": 0}, "preloaded_noema_context_units": {"type": "integer", "minimum": 0}, "exclusions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "runtime_resource_policy": {"type": "object", "required": ["posture", "parallelism_ceiling", "optional_external_calls", "dedupe_reads", "batch_reads_when_safe", "reason_codes"], "properties": {"posture": {"enum": ["NORMAL", "CONSERVE", "THROTTLED", "BLOCKED", "UNKNOWN"]}, "parallelism_ceiling": {"type": "integer", "minimum": 1}, "optional_external_calls": {"enum": ["NORMAL", "CONSERVE", "DEFER"]}, "dedupe_reads": {"type": "boolean"}, "batch_reads_when_safe": {"type": "boolean"}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "snapshot_ref": {"type": ["object", "null"]}}, "additionalProperties": false},
    "capability_requirements": {"type": "array", "items": {"type": "object"}},
    "resolver_receipts": {"type": "array", "items": {"type": "object", "required": ["resolver", "status"], "properties": {"resolver": {"type": "string"}, "status": {"enum": ["RESOLVED", "PARTIAL", "UNRESOLVED", "NOT_REQUIRED", "BLOCKED"]}, "result_ref": {"type": ["object", "null"]}, "integrity": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "tool_decisions": {"type": "array", "items": {"type": "object", "required": ["candidate", "decision", "reason_codes", "source_relation", "availability", "qualification"], "properties": {"candidate": {"type": "string"}, "decision": {"enum": ["CALL", "SOFT_SUPPRESS", "HARD_DENY", "DEFER"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "source_relation": {"type": "string"}, "availability": {"type": "string"}, "qualification": {"type": "string"}}, "additionalProperties": false}},
    "executor": {"type": "object", "required": ["requirements", "selected_executor"], "properties": {"requirements": {"type": "object"}, "selected_executor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "model": {"type": "object", "required": ["requirements", "selected_model"], "properties": {"requirements": {"type": "object"}, "selected_model": {"type": ["string", "null"]}}, "additionalProperties": false},
    "topology": {"type": "object", "required": ["mode", "max_parallelism", "role_bindings"], "properties": {"mode": {"enum": ["SINGLE", "AUDITED_SINGLE", "PARALLEL_ISOLATED"]}, "max_parallelism": {"type": "integer", "minimum": 1, "maximum": 2}, "role_bindings": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false},
    "evaluation_constraints": {"type": "object", "required": ["quality_claim_ids", "required_grader_classes", "exact_target_required", "independent_review_required", "regression_sensitive"], "properties": {"quality_claim_ids": {"type": "array", "items": {"type": "string"}}, "required_grader_classes": {"type": "array", "items": {"type": "string"}}, "exact_target_required": {"type": "boolean"}, "independent_review_required": {"type": "boolean"}, "regression_sensitive": {"type": "boolean"}}, "additionalProperties": false},
    "recovery": {"type": "object", "required": ["retry_cap", "idempotency_key", "checkpoint_ref", "rollback_ref", "resume_check_required", "expected_sha"], "properties": {"retry_cap": {"type": "integer", "minimum": 0, "maximum": 10}, "idempotency_key": {"type": ["string", "null"]}, "checkpoint_ref": {"type": ["object", "null"]}, "rollback_ref": {"type": ["object", "null"]}, "resume_check_required": {"type": "boolean"}, "expected_sha": {"type": ["string", "null"]}}, "additionalProperties": false},
    "evidence_refs": {"type": "array", "items": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}}
  }, "additionalProperties": false
}
