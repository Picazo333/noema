{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:schema:execution-envelope:1",
  "type": "object",
  "required": ["contract_version", "execution_id", "work_order_ref", "work_order_id", "project_id", "profile", "policy_version", "created_at", "baseline_ref", "disposition", "reason_codes", "decision", "context", "runtime_resource_policy", "capability_requirements", "resolver_receipts", "tool_decisions", "executor", "model", "topology", "evaluation_constraints", "recovery", "evidence_refs", "effective_needs", "input_bindings"],
  "properties": {
    "contract_version": {"const": "execution-envelope/v1"},
    "execution_id": {"type": "string", "pattern": "^exec-[a-z0-9-]+$"},
    "work_order_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"},
    "work_order_id": {"$ref": "urn:noema:schema:common:1#/$defs/identifier"},
    "project_id": {"$ref": "urn:noema:schema:common:1#/$defs/identifier"},
    "profile": {"type": "string"},
    "policy_version": {"const": "eg-policy-v1"},
    "created_at": {"$ref": "urn:noema:schema:common:1#/$defs/timestamp"},
    "baseline_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"},
    "disposition": {"enum": ["DIRECT_EXECUTION", "ROUTED", "NO_ACTION", "DEFER", "ROUTE_ELSEWHERE", "BLOCKED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "decision": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/decision"},
    "context": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/context"},
    "runtime_resource_policy": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/runtimePolicy"},
    "capability_requirements": {"type": "array", "items": {"type": "object"}},
    "resolver_receipts": {"type": "array", "items": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/resolverReceipt"}},
    "tool_decisions": {"type": "array", "items": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/toolDecision"}},
    "executor": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/executor"},
    "model": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/model"},
    "topology": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/topology"},
    "evaluation_constraints": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/evaluation"},
    "recovery": {"$ref": "urn:noema:schema:execution-envelope:0#/$defs/recovery"},
    "evidence_refs": {"type": "array", "items": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}},
    "effective_needs": {"$ref": "#/$defs/needs"},
    "input_bindings": {"type": "object", "required": ["work_order", "metadata", "runtime_pressure", "candidate_snapshot", "resolver_receipts", "host_capabilities", "manifest"], "additionalProperties": {"$ref": "#/$defs/binding"}}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"topology": {"properties": {"mode": {"const": "PARALLEL_ISOLATED"}}, "required": ["mode"]}}}, "then": {"properties": {"topology": {"properties": {"write_scopes": {"type": "array", "minItems": 2}, "role_bindings": {"type": "array", "minItems": 2}}, "required": ["write_scopes", "role_bindings"]}}}}],
  "$defs": {
    "needs": {"type": "object", "required": ["capability_requirements", "resolution_required", "tool_capabilities", "required_resources", "required_interfaces", "executor_required", "model_required", "write_targets", "external_effect_required", "independent_review_required"], "properties": {"capability_requirements": {"$ref": "#/$defs/identifiers"}, "resolution_required": {"type": "boolean"}, "tool_capabilities": {"$ref": "#/$defs/identifiers"}, "required_resources": {"$ref": "#/$defs/identifiers"}, "required_interfaces": {"$ref": "#/$defs/identifiers"}, "executor_required": {"type": "boolean"}, "model_required": {"type": "boolean"}, "write_targets": {"$ref": "#/$defs/identifiers"}, "external_effect_required": {"type": "boolean"}, "independent_review_required": {"type": "boolean"}}, "additionalProperties": false},
    "identifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "binding": {"type": "object", "required": ["snapshot", "digest", "source_ref"], "properties": {"snapshot": {}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "source_ref": {"$ref": "urn:noema:schema:common:1#/$defs/storageRef"}}, "additionalProperties": false}
  }
}
