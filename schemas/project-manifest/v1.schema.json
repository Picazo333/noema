{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noema:schema:project-manifest:1",
  "type": "object",
  "required": [
    "noema",
    "project",
    "authority",
    "sources_of_truth",
    "context",
    "quality_claims"
  ],
  "properties": {
    "noema": {
      "type": "object",
      "required": [
        "protocol",
        "contracts"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "contracts": {
          "type": "object",
          "required": [
            "project_manifest"
          ],
          "properties": {
            "project_manifest": {
              "const": 1
            }
          },
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "urn:noema:schema:common:1#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "archived",
            "experimental"
          ]
        }
      },
      "additionalProperties": false
    },
    "traits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "owns",
        "does_not_own"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "does_not_own": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sources_of_truth": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:noema:schema:common:1#/$defs/storageRef"
      }
    },
    "context": {
      "type": "object",
      "required": [
        "entrypoint",
        "default_mode"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "default_mode": {
          "enum": [
            "patch",
            "build",
            "audit",
            "research",
            "architect",
            "recover"
          ]
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "quality_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "urn:noema:schema:common:1#/$defs/relation"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason",
          "scope",
          "approved_by",
          "revisit_when"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "revisit_when": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
