{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stackia/pricing-reference@1",
  "title": "StackIA Pricing Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "semantics",
    "prices"
  ],
  "properties": {
    "schema": {
      "const": "stackia/pricing-reference@1"
    },
    "status": {
      "const": "canonical-reference"
    },
    "semantics": {
      "type": "object"
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "access_model",
          "current_label",
          "checked_at",
          "source_refs"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "access_model": {
            "enum": [
              "PAID",
              "INCLUDED",
              "FREE",
              "FREEMIUM",
              "OPEN_SOURCE",
              "USAGE_BASED",
              "UNKNOWN"
            ]
          },
          "current_label": {
            "type": "string",
            "minLength": 1
          },
          "selected_plan_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
